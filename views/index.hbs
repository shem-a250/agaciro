    <!-- ==================== SCRIPTS ==================== -->
   <script>
    // =========================
    // API ROUTES
    // =========================
    const NEWS_API = "/api/news";
    const STAFF_API = "/api/staff";
    const SCHEDULE_API = "/api/schedule";
    const IMAGES_API = "/api/images";

    let currentScheduleFilter = "all";

    // =========================
    // SMALL HELPERS
    // =========================
    function escapeHTML(value) {
        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function isImageUrl(value) {
        if (!value) return false;
        return value.startsWith("http") || value.startsWith("/") || value.startsWith("data:image");
    }

    function formatDate(dateValue) {
        if (!dateValue) return "";
        const date = new Date(dateValue + "T00:00:00");

        if (isNaN(date.getTime())) {
            return dateValue;
        }

        return date.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric"
        });
    }

    function formatScheduleDate(dateValue) {
        if (!dateValue) return "";
        const date = new Date(dateValue + "T00:00:00");

        if (isNaN(date.getTime())) {
            return dateValue;
        }

        return date.toLocaleDateString("en-US", {
            weekday: "short",
            month: "short",
            day: "numeric"
        });
    }

    function capitalizeFirst(text) {
        if (!text) return "";
        return text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
    }

    function getStatusText(status) {
        const cleanStatus = status || "Scheduled";

        if (cleanStatus === "Upcoming") return "🔴 Upcoming";
        if (cleanStatus === "Pending") return "🟡 Pending";
        if (cleanStatus === "Completed") return "✅ Completed";
        return "✅ Scheduled";
    }

    // =========================
    // DATABASE RENDER: SCHEDULE
    // =========================
    async function renderClientSchedule() {
        const tbody = document.getElementById("clientScheduleBody");
        if (!tbody) return;

        try {
            const response = await fetch(SCHEDULE_API);
            const result = await response.json();

            if (!result.success) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align:center;color:#ff6b6b;">
                            ${escapeHTML(result.message || "Failed to load schedule")}
                        </td>
                    </tr>
                `;
                return;
            }

            const schedule = result.data || [];

            if (!schedule.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align:center;">
                            No schedule events found
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = schedule.map(item => {
                const type = (item.type || "training").toLowerCase();
                const displayType = capitalizeFirst(type);

                return `
                    <tr data-type="${escapeHTML(type)}">
                        <td>${escapeHTML(formatScheduleDate(item.date))}</td>
                        <td>${escapeHTML(item.time)}</td>
                        <td>${escapeHTML(item.activity)}</td>
                        <td><span class="match-badge badge-${escapeHTML(type)}">${escapeHTML(displayType)}</span></td>
                        <td>${escapeHTML(item.location)}</td>
                        <td>${escapeHTML(getStatusText(item.status))}</td>
                    </tr>
                `;
            }).join("");

            applyScheduleFilter();

        } catch (error) {
            console.error("Client schedule error:", error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" style="text-align:center;color:#ff6b6b;">
                        Server connection failed
                    </td>
                </tr>
            `;
        }
    }

    // =========================
    // DATABASE RENDER: NEWS
    // =========================
    async function renderClientNews() {
        const grid = document.getElementById("clientNewsGrid");
        if (!grid) return;

        try {
            const response = await fetch(NEWS_API);
            const result = await response.json();

            if (!result.success) {
                grid.innerHTML = `<p style="color:#ff6b6b;">${escapeHTML(result.message || "Failed to load news")}</p>`;
                return;
            }

            const news = result.data || [];

            if (!news.length) {
                grid.innerHTML = `<p style="color:#bbb;">No news found.</p>`;
                return;
            }

            grid.innerHTML = news.map(item => {
                const imageValue = item.image || "📰";

                const imageHTML = isImageUrl(imageValue)
                    ? `<img src="${escapeHTML(imageValue)}" alt="${escapeHTML(item.title)}" style="width:100%;height:100%;object-fit:cover;">`
                    : escapeHTML(imageValue);

                return `
                    <div class="news-card">
                        <div class="news-card-image">
                            ${imageHTML}
                            <div class="news-date-badge">${escapeHTML(formatDate(item.date))}</div>
                        </div>
                        <div class="news-card-body">
                            <span class="news-category">${escapeHTML(item.category)}</span>
                            <h3>${escapeHTML(item.title)}</h3>
                            <p>${escapeHTML(item.description)}</p>
                           
                        </div>
                    </div>
                `;
            }).join("");

        } catch (error) {
            console.error("Client news error:", error);
            grid.innerHTML = `<p style="color:#ff6b6b;">Server connection failed.</p>`;
        }
    }

    // =========================
    // DATABASE RENDER: STAFF
    // =========================
    async function renderClientStaff() {
        const grid = document.getElementById("clientStaffGrid");
        if (!grid) return;

        try {
            const response = await fetch(STAFF_API);
            const result = await response.json();

            if (!result.success) {
                grid.innerHTML = `<p style="color:#ff6b6b;">${escapeHTML(result.message || "Failed to load staff")}</p>`;
                return;
            }

            const staff = result.data || [];

            if (!staff.length) {
                grid.innerHTML = `<p style="color:#bbb;">No staff found.</p>`;
                return;
            }

            grid.innerHTML = staff.map(item => {
                const avatarValue = item.image || "👤";

                const avatarHTML = isImageUrl(avatarValue)
                    ? `<img src="${escapeHTML(avatarValue)}" alt="${escapeHTML(item.name)}" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">`
                    : escapeHTML(avatarValue);

                const emailLink = item.email
                    ? `<a href="mailto:${escapeHTML(item.email)}" title="Email">@</a>`
                    : `<a href="#" title="Email" onclick="return false;">@</a>`;

                const phoneLink = item.phone
                    ? `<a href="tel:${escapeHTML(item.phone)}" title="Phone">☎</a>`
                    : "";

                return `
                    <div class="staff-card">
                        <div class="staff-avatar">
                            ${avatarHTML}
                            <div class="staff-role-badge">${escapeHTML(item.role)}</div>
                        </div>
                        <div class="staff-card-body">
                            <h3>${escapeHTML(item.name)}</h3>
                            <p class="staff-title">${escapeHTML(item.title || item.role)}</p>
                            <p>${escapeHTML(item.bio || "Dedicated AGACIRO Football Academy staff member.")}</p>
                            <div class="staff-social">
                                ${emailLink}
                                ${phoneLink}
                            </div>
                        </div>
                    </div>
                `;
            }).join("");

        } catch (error) {
            console.error("Client staff error:", error);
            grid.innerHTML = `<p style="color:#ff6b6b;">Server connection failed.</p>`;
        }
    }

    // =========================
    // DATABASE RENDER: GALLERY
    // =========================
   // =========================
    // DATABASE RENDER: GALLERY
    // =========================
    async function renderClientGallery() {
        const homeGrid = document.getElementById("clientGalleryGrid");
        const fullGrid = document.getElementById("clientFullGalleryGrid");

        try {
            const response = await fetch(IMAGES_API);
            const result = await response.json();

            if (!result.success) {
                console.warn(result.message || "Failed to load gallery");
                return;
            }

            const images = result.data || [];

            if (!images.length) return;

            // 1. Render for Home Page Preview Grid (Randomized & limited to 7)
            if (homeGrid) {
                const shuffled = [...images].sort(() => Math.random() - 0.5);
                const galleryImages = shuffled.slice(0, 7);

                homeGrid.innerHTML = galleryImages.map((item, index) => {
                    const sizeClass = index % 5 === 0 ? "tall" : index % 4 === 0 ? "wide" : "";
                    const imageValue = item.image || "⚽";

                    const imageHTML = isImageUrl(imageValue)
                        ? `<img src="${escapeHTML(imageValue)}" alt="${escapeHTML(item.title)}" style="width:100%;height:100%;object-fit:cover;">`
                        : `<div class="gallery-placeholder gp-${(index % 7) + 1}">${escapeHTML(imageValue)}</div>`;

                    return `
                        <div class="gallery-item ${sizeClass}">
                            ${imageHTML}
                            <div class="gallery-overlay">
                                <h4>${escapeHTML(item.title)}</h4>
                                <p>${escapeHTML(item.description || item.category || "")}</p>
                            </div>
                        </div>
                    `;
                }).join("");
            }

            // 2. Render for Dedicated Gallery Page (Shows ALL images)
            if (fullGrid) {
                fullGrid.innerHTML = images.map((item, index) => {
                    const sizeClass = index % 5 === 0 ? "tall" : index % 4 === 0 ? "wide" : "";
                    const imageValue = item.image || "⚽";

                    return `
                        <div class="gallery-item ${sizeClass}">
                            <img src="${escapeHTML(imageValue)}" alt="${escapeHTML(item.title)}" style="width:100%;height:100%;object-fit:cover;">
                            <div class="gallery-overlay">
                                <h4>${escapeHTML(item.title)}</h4>
                                <p>${escapeHTML(item.description || item.category || "")}</p>
                            </div>
                        </div>
                    `;
                }).join("");
            }

        } catch (error) {
            console.error("Client gallery error:", error);
        }
    }


// =========================
// DATABASE RENDER: SCHEDULE HERO BACKGROUND
// =========================
async function renderScheduleHeroImages() {
    const track = document.getElementById("scheduleHeroTrack");
    if (!track) return;

    try {
        const response = await fetch(IMAGES_API);
        const result = await response.json();

        if (!result.success) {
            console.warn(result.message || "Failed to load schedule hero images");
            return;
        }

        const images = (result.data || [])
            .map(item => item.image)
            .filter(image => isImageUrl(image));

        if (!images.length) {
            return;
        }

        // Duplicate images so the scrolling loop becomes smooth and endless
        const repeatedImages = [...images, ...images, ...images];

        track.innerHTML = repeatedImages.map((image, index) => {
            return `
                <div class="schedule-hero-img-card">
                    <img src="${escapeHTML(image)}" alt="AGACIRO schedule background ${index + 1}">
                </div>
            `;
        }).join("");

    } catch (error) {
        console.error("Schedule hero images error:", error);
    }
}
    // =========================
    // NAVIGATION
    // =========================
    function navigateTo(pageName) {
        document.querySelectorAll(".page-section").forEach(section => {
            section.classList.remove("active-page");
        });

        const targetPage = document.getElementById("page-" + pageName);
        if (targetPage) {
            targetPage.classList.add("active-page");
        }

        document.querySelectorAll(".nav-links a").forEach(link => {
            link.classList.remove("active");
            if (link.getAttribute("data-page") === pageName) {
                link.classList.add("active");
            }
        });

        document.querySelectorAll(".mobile-menu a").forEach(link => {
            link.classList.remove("active-mob");
            if (link.getAttribute("data-page") === pageName) {
                link.classList.add("active-mob");
            }
        });

        window.scrollTo({ top: 0, behavior: "smooth" });

        const mobileMenu = document.getElementById("mobileMenu");
        const mobileOverlay = document.getElementById("mobileOverlay");
        const hamburger = document.getElementById("hamburger");

        if (mobileMenu && mobileMenu.classList.contains("active")) {
            mobileMenu.classList.remove("active");
            mobileOverlay.classList.remove("active");
            hamburger.classList.remove("active");
        }

        if (window.location.hash !== "#" + pageName) {
            window.location.hash = pageName;
        }
    }

    // =========================
    // MOBILE MENU
    // =========================
    function toggleMobileMenu() {
        const mobileMenu = document.getElementById("mobileMenu");
        const mobileOverlay = document.getElementById("mobileOverlay");
        const hamburger = document.getElementById("hamburger");

        mobileMenu.classList.toggle("active");
        mobileOverlay.classList.toggle("active");
        hamburger.classList.toggle("active");
    }

    // =========================
    // NAVBAR SCROLL EFFECT
    // =========================
    window.addEventListener("scroll", () => {
        const navbar = document.getElementById("navbar");

        if (window.scrollY > 50) {
            navbar.classList.add("scrolled");
        } else {
            navbar.classList.remove("scrolled");
        }
    });

    // =========================
    // SCHEDULE TAB FILTER
    // =========================
    function switchScheduleTab(type, btn) {
        currentScheduleFilter = type;

        document.querySelectorAll(".schedule-tab").forEach(tab => {
            tab.classList.remove("active-tab");
        });

        if (btn) {
            btn.classList.add("active-tab");
        }

        applyScheduleFilter();
    }

    function applyScheduleFilter() {
        const rows = document.querySelectorAll("#scheduleTable tbody tr");

        rows.forEach(row => {
            if (currentScheduleFilter === "all") {
                row.style.display = "";
            } else {
                row.style.display = row.getAttribute("data-type") === currentScheduleFilter ? "" : "none";
            }
        });
    }

    // =========================
    // INITIALIZE
    // =========================
    document.addEventListener("DOMContentLoaded", async () => {
        
        await Promise.all([
            renderClientSchedule(),
            renderClientNews(),
            renderClientStaff(),
            renderClientGallery()
        ]);

        // Refresh every 1 minute
        setInterval(() => {
            renderClientGallery();
        }, 60000);

        renderStaticScheduleHeroImages();
        
        startSlideshow(".hero-bg", backgroundSlides.hero);
        startSlideshow(".schedule-hero", backgroundSlides.schedule);
        startSlideshow(".news-hero", backgroundSlides.news);
        startSlideshow(".staff-hero", backgroundSlides.staff);

        const hash = window.location.hash.replace("#", "");

        if (hash && ["home", "schedule", "news", "staff", "gallery"].includes(hash)) {
            navigateTo(hash);
        } else {
            navigateTo("home");
        }
    });

    window.addEventListener("hashchange", () => {
        const hash = window.location.hash.replace("#", "");

        if (hash && ["home", "schedule", "news", "staff"].includes(hash)) {
            navigateTo(hash);
        }
    });


    // =========================
// STATIC RENDER: SCHEDULE HERO IMAGES
// =========================
function renderStaticScheduleHeroImages() {
    const track = document.getElementById("scheduleHeroTrack");
    if (!track) return;

    const images = [
        "/images/AGACIRO FOOTBALL ACADEMY,we started at the grassroots to the elite. (1).jpg",
        "/images/AGACIRO FOOTBALL ACADEMY,we started at the grassroots to the elite. (2).jpg",
        "/images/AGACIRO FOOTBALL ACADEMY,we started at the grassroots to the elite. (3).jpg"
    ];

    const repeatedImages = [...images, ...images, ...images];

    track.innerHTML = repeatedImages.map((image, index) => {
        return `
            <div class="schedule-hero-img-card">
                <img src="${encodeURI(image)}" alt="AGACIRO schedule background ${index + 1}">
            </div>
        `;
    }).join("");
}
// =========================
// HERO / NEWS / STAFF BACKGROUND SLIDESHOW
// =========================

const backgroundSlides = {

    hero: [
        "/images/welcome1.jpg",
        "/images/welcome2.jpg",
        "/images/welcome3.jpg"
    ],

    schedule: [
     "/images/staff1.jpg",
        "/images/staff2.jpg",
        "/images/staff3.jpg"
       
    ],

    news: [
        "/images/news1.jpg",
        "/images/news2.jpg",
        "/images/news3.jpg"
    ],

    staff: [
        "/images/staff1.jpg",
        "/images/staff2.jpg",
        "/images/staff3.jpg"
    ]

};


function startSlideshow(selector, images) {

    const element = document.querySelector(selector);

    if (!element || images.length === 0) return;

    let index = 0;

    function changeImage() {

        element.style.backgroundImage =
            `url("${encodeURI(images[index])}")`;

        index++;

        if (index >= images.length) {
            index = 0;
        }

    }

    changeImage();

    setInterval(changeImage, 5000);

}
</script>
</body>
</html>