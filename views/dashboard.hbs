<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AGACIRO Academy • Admin Dashboard</title>
  <!-- Chart.js for performance charts -->
