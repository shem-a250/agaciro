        <option>matches</option>
        <option>trophies</option>
        <option>academy</option>
      </select>
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea id="imageDescription" rows="4" placeholder="Write image description..."></textarea>
    </div>

    <input type="hidden" id="imageEditId">

    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeImageModal()">Cancel</button>
      <button class="btn btn-aqua" onclick="saveImage()">Save</button>
