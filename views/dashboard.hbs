        <option>Player Spotlight</option>
        <option>Facilities</option>
        <option>Partnership</option>
      </select>
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea id="newsDescription" rows="4" placeholder="Write news description..."></textarea>
    </div>

    <div class="form-group">
      <label>Date</label>
      <input type="date" id="newsDate">
    </div>

    <input type="hidden" id="newsEditId">

    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeNewsModal()">Cancel</button>
      <button class="btn btn-aqua" onclick="saveNews()">Save</button>
