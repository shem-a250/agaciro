  </div>
</div>

<!-- Staff Modal -->
<div class="modal" id="staffModal">
  <div class="modal-content">
    <h3 id="staffModalTitle">Add Staff Member</h3>
    <div class="form-group"><label>Avatar (emoji or URL)</label><input type="text" id="staffAvatar" placeholder="👨‍💼"></div>
    <div class="form-group"><label>Name</label><input type="text" id="staffName" placeholder="Full name"></div>
    <div class="form-group"><label>Role</label><input type="text" id="staffRole" placeholder="e.g. Head Coach"></div>
    <div class="form-group"><label>Experience</label><input type="text" id="staffExp" placeholder="10+ years"></div>
    <input type="hidden" id="staffEditId">
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeStaffModal()">Cancel</button>
      <button class="btn btn-aqua" onclick="saveStaff()">Save</button>
    </div>
  </div>
</div>

<!-- Schedule Modal -->
<div class="modal" id="scheduleModal">
  <div class="modal-content">
    <h3 id="scheduleModalTitle">Add Schedule Event</h3>
    <div class="form-group"><label>Date</label><input type="date" id="schedDate"></div>
    <div class="form-group"><label>Time</label><input type="text" id="schedTime" placeholder="07:00 - 09:00"></div>
    <div class="form-group"><label>Activity</label><input type="text" id="schedActivity" placeholder="Training / Match"></div>
    <div class="form-group"><label>Type</label>
      <select id="schedType"><option>Training</option><option>Match</option><option>Friendly</option></select>
    </div>
    <div class="form-group"><label>Location</label><input type="text" id="schedLocation" placeholder="Main Pitch"></div>
    <div class="form-group"><label>Status</label>
      <select id="schedStatus"><option>Scheduled</option><option>Upcoming</option><option>Pending</option><option>Completed</option></select>
    </div>
    <input type="hidden" id="schedEditId">
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeScheduleModal()">Cancel</button>
      <button class="btn btn-aqua" onclick="saveSchedule()">Save</button>
    </div>
  </div>
</div>

<script>
  // ---------- DATA STORE ----------
  const STORAGE_KEYS = {
    news: 'agaciro_news',
    staff: 'agaciro_staff',
    schedule: 'agaciro_schedule',
    feedback: 'agaciro_feedback'
  };

  // Default demo data
  const defaultNews = [
    { id: 1, image: '🏆', title: 'AGACIRO Wins Regional Cup 2026', category: 'Tournament', date: '2026-05-20' },
    { id: 2, image: '🎓', title: 'New Scholarship Program Launched', category: 'Academy', date: '2026-05-15' },
    { id: 3, image: '⚽', title: 'Jean d\'Amour Signs Pro Contract', category: 'Player Spotlight', date: '2026-05-10' }
  ];
  const defaultStaff = [
    { id: 1, avatar: '👨‍💼', name: 'Coach Mugisha', role: 'Head Coach', experience: 'UEFA A • 15+ yrs' },
    { id: 2, avatar: '🧑‍🏫', name: 'Coach Uwimana', role: 'Assistant Coach', experience: 'CAF B • 10 yrs' },
    { id: 3, avatar: '🧤', name: 'Coach Habimana', role: 'Goalkeeper Coach', experience: '12 yrs' }
  ];
  const defaultSchedule = [
    { id: 1, date: '2026-05-26', time: '07:00-09:00', activity: 'Morning Fitness', type: 'Training', location: 'Main Pitch', status: 'Scheduled' },
    { id: 2, date: '2026-05-28', time: '16:00', activity: 'AGACIRO vs Kigali United', type: 'Match', location: 'Main Stadium', status: 'Upcoming' },
    { id: 3, date: '2026-06-01', time: '15:00', activity: 'AGACIRO vs Musanze FC', type: 'Match', location: 'Main Stadium', status: 'Upcoming' }
  ];
  const defaultFeedback = [
    { id: 1, name: 'Eric M.', message: 'Great academy! My son improved so much.', rating: 5, date: '2026-05-10' },
    { id: 2, name: 'Grace U.', message: 'Excellent coaching staff, highly recommended.', rating: 4, date: '2026-05-12' },
    { id: 3, name: 'Patrick K.', message: 'Need more weekend sessions.', rating: 3, date: '2026-05-15' }
  ];

  // Helper functions
  function getData(key) {
    const stored = localStorage.getItem(key);
    return stored ? JSON.parse(stored) : null;
  }
  function setData(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
  }
  function initData() {
    // Only initialize feedback in localStorage since it isn't connected to the database yet.
    // News, staff, and schedule are now fetched directly from MongoDB!
    if (!getData(STORAGE_KEYS.feedback)) setData(STORAGE_KEYS.feedback, defaultFeedback);
  }

  // Helper to prevent Cross-Site Scripting (XSS)
  function escapeHTML(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // ---------- RENDER FUNCTIONS ----------
 async function renderOverview() {
  const newsCount = await getNewsCount();
  const staffCount = await getStaffCount();
  const scheduleCount = await getScheduleCount();

  const feedback = getData(STORAGE_KEYS.feedback) || [];

  const html = `
    <div class="stat-card"><h3>${newsCount}</h3><p>News Articles</p></div>
    <div class="stat-card"><h3>${staffCount}</h3><p>Staff Members</p></div>
    <div class="stat-card"><h3>${scheduleCount}</h3><p>Upcoming Events</p></div>
    <div class="stat-card"><h3>${feedback.length}</h3><p>Feedback Messages</p></div>
  `;

  document.getElementById('overviewStats').innerHTML = html;
}

   async function renderStaff() {
  const tbody = document.getElementById('staffTableBody');

  try {
    const response = await fetch(STAFF_API);
    const result = await response.json();

    if (!result.success) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align:center;color:red;">
            ${result.message || 'Failed to load staff'}
          </td>
        </tr>
      `;
      return;
    }

    const staff = result.data || [];

    if (!staff.length) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align:center;">No staff found</td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = staff.map(item => {
      const avatar = item.image || '👤';

      const avatarHtml =
        avatar.startsWith('http') || avatar.startsWith('/')
          ? `<img src="${avatar}" alt="${item.name}" style="width:42px;height:42px;border-radius:50%;object-fit:cover;">`
          : `<span style="font-size:1.8rem;">${avatar}</span>`;

      return `
        <tr>
          <td>${avatarHtml}</td>
          <td>${item.name || ''}</td>
          <td>${item.role || ''}</td>
          <td>${item.title || ''}</td>
          <td class="actions">
            <button class="btn btn-outline btn-sm" onclick="editStaff('${item._id}')">✏️</button>
            <button class="btn btn-danger btn-sm" onclick="deleteStaff('${item._id}')">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');

  } catch (error) {
    console.error('Render staff error:', error);
    tbody.innerHTML = `
      <tr>
        <td colspan="5" style="text-align:center;color:red;">
          Server connection failed
        </td>
      </tr>
    `;
  }
}

 async function renderSchedule() {
  const tbody = document.getElementById('scheduleTableBody');

  try {
    const response = await fetch(SCHEDULE_API);
    const result = await response.json();

    if (!result.success) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" style="text-align:center;color:red;">
            ${result.message || 'Failed to load schedule'}
          </td>
        </tr>
      `;
      return;
    }

    const schedule = result.data || [];

    if (!schedule.length) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" style="text-align:center;">No schedule events found</td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = schedule.map(item => {
      const type = item.type || "training";
      const displayType = type.charAt(0).toUpperCase() + type.slice(1);

      return `
        <tr>
          <td>${item.date || ''}</td>
          <td>${item.time || ''}</td>
          <td>${item.activity || ''}</td>
          <td><span class="badge-${type.toLowerCase()}">${displayType}</span></td>
          <td>${item.location || ''}</td>
          <td>${item.status || 'Scheduled'}</td>
          <td class="actions">
            <button class="btn btn-outline btn-sm" onclick="editSchedule('${item._id}')">✏️</button>
            <button class="btn btn-danger btn-sm" onclick="deleteSchedule('${item._id}')">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');

  } catch (error) {
    console.error('Render schedule error:', error);
    tbody.innerHTML = `
      <tr>
        <td colspan="7" style="text-align:center;color:red;">
          Server connection failed
        </td>
      </tr>
    `;
  }
}
  function renderFeedback() {
    const fb = getData(STORAGE_KEYS.feedback) || [];
    const tbody = document.getElementById('feedbackTableBody');
    tbody.innerHTML = fb.map(item => `
      <tr>
        <td>${item.name}</td>
        <td>${item.message}</td>
        <td>${'⭐'.repeat(item.rating)}</td>
        <td>${item.date}</td>
        <td class="actions">
          <button class="btn btn-danger btn-sm" onclick="deleteFeedback(${item.id})">🗑️</button>
        </td>
      </tr>
    `).join('');
  }

  // ---------- CRUD OPERATIONS ----------
  let nextId = (arr) => arr.length ? Math.max(...arr.map(i=>i.id)) + 1 : 1;

  // NEWS
 const NEWS_API = "/api/news";
const STAFF_API = "/api/staff";
const SCHEDULE_API = "/api/schedule";
const IMAGE_API = "/api/images";  

  async function getNewsCount() {
    try {
      const response = await fetch(NEWS_API);
      const result = await response.json();

      if (!result.success) return 0;
      return result.data ? result.data.length : 0;

    } catch (error) {
      console.error("News count error:", error);
      return 0;
    }
  }


async function getStaffCount() {
  try {
    const response = await fetch(STAFF_API);
    const result = await response.json();

    if (!result.success) return 0;
    return result.data ? result.data.length : 0;

  } catch (error) {
    console.error("Staff count error:", error);
    return 0;
  }
}

async function getScheduleCount() {
  try {
    const response = await fetch(SCHEDULE_API);
    const result = await response.json();

    if (!result.success) return 0;

    const schedule = result.data || [];

    return schedule.filter(e =>
      e.status === "Upcoming" ||
      e.status === "Scheduled"
    ).length;

  } catch (error) {
    console.error("Schedule count error:", error);
    return 0;
  }
}





  async function openNewsModal(id = null) {
    const newsEditId = document.getElementById("newsEditId");
    const newsImage = document.getElementById("newsImage");
    const newsTitle = document.getElementById("newsTitle");
    const newsCategory = document.getElementById("newsCategory");
    const newsDescription = document.getElementById("newsDescription");
    const newsDate = document.getElementById("newsDate");
    const newsModalTitle = document.getElementById("newsModalTitle");
    const newsModal = document.getElementById("newsModal");

    if (
      !newsEditId ||
      !newsImage ||
      !newsTitle ||
      !newsCategory ||
      !newsDescription ||
      !newsDate ||
      !newsModalTitle ||
      !newsModal
    ) {
      console.error("News modal element missing. Check IDs: newsEditId, newsImage, newsTitle, newsCategory, newsDescription, newsDate, newsModalTitle, newsModal.");
      alert("News modal has missing input IDs.");
      return;
    }

    newsEditId.value = id || "";

    if (id) {
      try {
        const response = await fetch(`${NEWS_API}/${id}`);
        const result = await response.json();

        if (!result.success) {
          alert(result.message || "News not found");
          return;
        }

        const news = result.data;

        newsImage.value = news.image || "";
        newsTitle.value = news.title || "";
        newsCategory.value = news.category || "Tournament";
        newsDescription.value = news.description || "";
        newsDate.value = news.date || "";
        newsModalTitle.textContent = "Edit News Article";

      } catch (error) {
        console.error("Open news error:", error);
        alert("Failed to open news");
        return;
      }

    } else {
      newsImage.value = "";
      newsTitle.value = "";
      newsCategory.value = "Tournament";
      newsDescription.value = "";
      newsDate.value = new Date().toISOString().split("T")[0];
      newsModalTitle.textContent = "Add News Article";
    }

    newsModal.classList.add("active");
  }

  function closeNewsModal() {
    document.getElementById("newsModal").classList.remove("active");
  }

  async function renderNews() {
    const tbody = document.getElementById('newsTableBody');

    try {
      const response = await fetch(NEWS_API);
      const result = await response.json();

      if (!result.success) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align:center;color:red;">
              ${result.message || 'Failed to load news'}
            </td>
          </tr>
        `;
        return;
      }

      const news = result.data || [];

      if (!news.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align:center;">No news found</td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = news.map(item => {
        const image = item.image || '📰';
        const imageHtml =
          image.startsWith('http') || image.startsWith('/')
            ? `<img src="${image}" alt="${item.title}" style="width:42px;height:42px;border-radius:4px;object-fit:cover;">`
            : `<span style="font-size:1.8rem;">${image}</span>`;

        return `
          <tr>
            <td>${imageHtml}</td>
            <td>${escapeHTML(item.title)}</td>
            <td>${escapeHTML(item.category)}</td>
            <td>${escapeHTML(item.date)}</td>
            <td class="actions">
              <button class="btn btn-outline btn-sm" onclick="editNews('${item._id}')">✏️</button>
              <button class="btn btn-danger btn-sm" onclick="deleteNews('${item._id}')">🗑️</button>
            </td>
          </tr>
        `;
      }).join('');

    } catch (error) {
      console.error('Render news error:', error);
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align:center;color:red;">
            Server connection failed
          </td>
        </tr>
      `;
    }
  }

  async function saveNews() {
    const newsEditId = document.getElementById("newsEditId");

    const entry = {
      image: document.getElementById("newsImage").value.trim(),
      title: document.getElementById("newsTitle").value.trim(),
      category: document.getElementById("newsCategory").value.trim(),
      description: document.getElementById("newsDescription").value.trim(),
      date: document.getElementById("newsDate").value
    };

    if (!entry.title || !entry.category || !entry.description) {
      alert("Title, category and description are required");
      return;
    }

    const id = newsEditId.value;

    try {
      const response = await fetch(id ? `${NEWS_API}/${id}` : NEWS_API, {
        method: id ? "PUT" : "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(entry)
      });

      const result = await response.json();

      if (!result.success) {
        alert(result.message || "Failed to save news");
        return;
      }

      closeNewsModal();
      await renderNews();
      await renderOverview();

      alert(id ? "News updated successfully" : "News added successfully");

    } catch (error) {
      console.error("Save news error:", error);
      alert("Failed to save news to database");
    }
  }

  function editNews(id) {
    openNewsModal(id);
  }

  async function deleteNews(id) {
    if (!confirm("Delete this news article?")) return;

    try {
      const response = await fetch(`${NEWS_API}/${id}`, {
        method: "DELETE"
      });

      const result = await response.json();

      if (!result.success) {
        alert(result.message || "Failed to delete news");
        return;
      }

      await renderNews();
      await renderOverview();

    } catch (error) {
      console.error("Delete news error:", error);
      alert("Failed to delete news");
    }
  }

    // IMAGES
  async function renderImages() {
    const tbody = document.getElementById('imageTableBody');

    try {
      const response = await fetch(IMAGE_API);
      const result = await response.json();

      if (!result.success) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align:center;color:red;">
              ${result.message || 'Failed to load images'}
            </td>
          </tr>
        `;
        return;
      }

      const images = result.data || [];

      if (!images.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align:center;">No images found</td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = images.map(item => {
        const preview = item.image || '🖼️';
        const previewHtml =
          preview.startsWith('http') || preview.startsWith('/')
            ? `<img src="${preview}" alt="${item.title}" style="width:60px;height:60px;border-radius:4px;object-fit:cover;">`
            : `<span style="font-size:1.8rem;">${preview}</span>`;

        return `
          <tr>
            <td>${previewHtml}</td>
            <td>${item.title || ''}</td>
            <td><span class="badge-${item.category}">${item.category}</span></td>
            <td>${item.description ? item.description.substring(0, 50) + '...' : ''}</td>
            <td class="actions">
              <button class="btn btn-outline btn-sm" onclick="editImage('${item._id}')">✏️</button>
              <button class="btn btn-danger btn-sm" onclick="deleteImage('${item._id}')">🗑️</button>
            </td>
          </tr>
        `;
      }).join('');

    } catch (error) {
      console.error('Render images error:', error);
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align:center;color:red;">
            Server connection failed
          </td>
        </tr>
      `;
    }
  }

  async function openImageModal(id = null) {
    const imageEditId = document.getElementById("imageEditId");
    const imageFile = document.getElementById("imageFile");
    const imageTitle = document.getElementById("imageTitle");
    const imageCategory = document.getElementById("imageCategory");
    const imageDescription = document.getElementById("imageDescription");
    const imageModalTitle = document.getElementById("imageModalTitle");
    const imageModal = document.getElementById("imageModal");

    if (
    !imageEditId ||
    !imageFile ||
    !imageTitle ||
    !imageCategory ||
    !imageDescription ||
    !imageModalTitle ||
    !imageModal
) {
    alert("Image modal has missing input IDs.");
    return;
}

    imageEditId.value = id || "";

    if (id) {
      try {
        const response = await fetch(`${IMAGE_API}/${id}`);
        const result = await response.json();

        if (!result.success) {
          alert(result.message || "Image not found");
          return;
        }

        const image = result.data;

         
        imageTitle.value = image.title || "";
        imageCategory.value = image.category || "academy";
        imageDescription.value = image.description || "";
        imageModalTitle.textContent = "Edit Image";

      } catch (error) {
        console.error("Open image error:", error);
        alert("Failed to open image");
        return;
      }

    } else {
      imageFile.value = "";
      imageTitle.value = "";
      imageCategory.value = "academy";
      imageDescription.value = "";
      imageModalTitle.textContent = "Add Image";
    }

    imageModal.classList.add("active");
  }

  function closeImageModal() {
    document.getElementById("imageModal").classList.remove("active");
  }

  async function saveImage() {

    const id = document.getElementById("imageEditId").value;

    const imageFile = document.getElementById("imageFile").files[0];

    const title = document.getElementById("imageTitle").value.trim();
    const category = document.getElementById("imageCategory").value;
    const description = document.getElementById("imageDescription").value.trim();

    if (!title || !category) {
        alert("Title and category are required.");
        return;
    }

    if (!id && !imageFile) {
        alert("Please choose an image.");
        return;
    }

    const formData = new FormData();

    formData.append("title", title);
    formData.append("category", category);
    formData.append("description", description);

    if (imageFile) {
        formData.append("image", imageFile);
    }

    try {

        const response = await fetch(
            id ? `/api/images/${id}` : "/api/images",
            {
                method: id ? "PUT" : "POST",
                body: formData
            }
        );

        const result = await response.json();

        if (!result.success) {
            alert(result.message);
            return;
        }

        closeImageModal();
        renderImages();

        alert(id ? "Image updated." : "Image uploaded.");

    } catch (err) {
        console.error(err);
        alert("Upload failed.");
    }

}

  function editImage(id) {
    openImageModal(id);
  }

  async function deleteImage(id) {
    if (!confirm("Delete this image?")) return;

    try {
      const response = await fetch(`${IMAGE_API}/${id}`, {
        method: "DELETE"
      });

      const result = await response.json();

      if (!result.success) {
        alert(result.message || "Failed to delete image");
        return;
      }

      await renderImages();

    } catch (error) {
      console.error("Delete image error:", error);
      alert("Failed to delete image");
    }
  }

